# Copy to .env for local development.
DEBUG=1
SECRET_KEY=change-me
# Leave unset to use a local SQLite file.
# DATABASE_URL=postgres://user:password@localhost:5432/schoolms
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional: created automatically by `python manage.py ensure_superadmin`
SUPERADMIN_USERNAME=owner
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_PASSWORD=change-me-too
